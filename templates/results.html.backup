{% extends "base.html" %}
{% block title %}Your internship assessment | ProofPath AI{% endblock %}

{% block content %}
  {% set uncertain_interpretations = analysis.skill_assessments|selectattr('uncertain')|list %}
  <section class="results-header" aria-labelledby="results-title">
    <p class="eyebrow">Your personalized assessment</p>
    <h1 id="results-title">{{ analysis.role_title }}</h1>
    <p class="results-overview">{{ analysis.overview }}</p>
    <p class="results-caveat">This assessment reflects only the information and examples you submitted. It does not verify your actual ability.</p>
    <div class="provided-context" aria-label="Information included in this assessment">
      <span><strong>Job description</strong> Provided</span>
      <span><strong>Current skills</strong> {{ 'Provided' if form_values.current_skills else 'Not provided' }}</span>
      <span><strong>Projects or work</strong> {{ 'Provided' if form_values.projects_and_work else 'Not provided' }}</span>
    </div>
  </section>

  <section class="results-section summary-section" aria-labelledby="summary-title">
    <div class="results-section-heading">
      <p class="eyebrow">Start here</p>
      <h2 id="summary-title">Assessment summary</h2>
      <p>Counts group requirements by the evidence described in your submitted examples; they do not measure competence.</p>
    </div>
    <div class="evidence-counts" aria-label="Evidence category counts">
      {% for category, count in evidence_counts.items() %}
        <div class="count-card">
          <span class="evidence-badge evidence-{{ loop.index }}">{{ category }}</span>
          <div class="count-value"><strong class="count-number">{{ count }}</strong><span class="count-caption">requirement{{ '' if count == 1 else 's' }}</span></div>
        </div>
      {% endfor %}
    </div>
    <p class="count-category-note">Counts use the three evidence categories. “Skill claimed — evidence not provided” remains part of “Evidence not provided.”</p>

    <h3 class="subheading">Key requirements identified</h3>
    <ul class="requirement-list">
      {% for skill in analysis.skill_assessments %}
        <li class="requirement-summary-item">
          <strong>{{ skill.skill_name }}</strong>
          <div class="requirement-summary-meta">
            <span class="requirement-meta-field"><span class="requirement-meta-label">Requirement type</span><span class="requirement-type">{{ skill.requirement_type|capitalize }}</span></span>
          </div>
        </li>
      {% endfor %}
    </ul>

    <div class="priority-note">
      <h3>Evidence gaps to address first</h3>
      {% if priority_gaps %}
        <ul>
          {% for skill in priority_gaps %}<li><strong>{{ skill.skill_name }} — Evidence gap:</strong> {{ skill.what_is_missing }}<br><span><strong>Next step:</strong> {{ skill.suggested_next_step }}</span></li>{% endfor %}
        </ul>
      {% else %}
        <p>The submitted examples cover the identified requirements. The plan can help organize and strengthen that evidence.</p>
      {% endif %}
    </div>
    <p class="uncertainty-note"><strong>How to read requirement types:</strong> Explicit means directly stated; preferred means the description says it is helpful or preferred; inferred means ProofPath AI interpreted it from a clue and it is not a definite employer requirement.</p>
  </section>

  <section class="results-section skill-section" aria-labelledby="skills-title">
    <div class="results-section-heading">
      <p class="eyebrow">The details</p>
      <h2 id="skills-title">Skill-by-skill assessment</h2>
      <p>Each evidence label describes only the submitted project or work examples; it does not verify skill or ability.</p>
    </div>
    <div class="skill-results">
      {% for skill in analysis.skill_assessments %}
        <article class="skill-result-card">
          <div class="skill-card-heading">
            <h3>{{ skill.skill_name }}</h3>
            <div class="evidence-label-group">
              <span class="evidence-label-caption">Submitted-example evidence</span>
              <span class="evidence-badge evidence-{{ {'Evidence provided': 1, 'Partial evidence': 2, 'Evidence not provided': 3}[skill.evidence_category] }}">
                {{ skill.display_evidence_label }}
              </span>
            </div>
          </div>
          <dl class="assessment-details">
            <div><dt>Requirement type</dt><dd>{{ skill.requirement_type|capitalize }}</dd></div>
            <div>
              <dt>Job-description excerpt</dt>
              <dd>{{ skill.job_description_basis }}</dd>
            </div>
            {% if skill.uncertainty_note %}
              <div class="interpretation-detail{% if skill.uncertain %} interpretation-uncertain{% endif %}"><dt>{% if skill.uncertain %}Why this inference is uncertain{% else %}Additional interpretation note{% endif %}</dt><dd>{{ skill.uncertainty_note }}</dd></div>
            {% endif %}
            <div>
              <dt>Your supporting example</dt>
              <dd>
                {% if skill.supporting_example_quote %}
                  <blockquote>{{ skill.supporting_example_quote }}</blockquote>
                {% elif skill.skill_claimed_by_user %}
                  <span class="claim-explanation">You reported this skill, but no supporting project or work example was provided. This does not mean you lack the skill.</span>
                {% else %}
                  No supporting project or work example was provided. This does not mean you lack the skill.
                {% endif %}
              </dd>
            </div>
            <div><dt>What is missing</dt><dd><strong>{{ skill.skill_name }} — Evidence gap:</strong> {{ skill.what_is_missing }}</dd></div>
            <div><dt>Suggested next step</dt><dd>{{ skill.suggested_next_step }}</dd></div>
          </dl>
        </article>
      {% endfor %}
    </div>
  </section>

  <div class="plan-reveal-wrap">
    <button class="button button-primary plan-reveal-button" type="button" id="reveal-plan" aria-expanded="false" aria-controls="plan-and-report">
      Create My 7-Day Portfolio Plan <span aria-hidden="true">↓</span>
    </button>
    <p class="plan-reveal-help">Your plan is already prepared from this validated assessment. Revealing it will not make another AI request.</p>
  </div>

  <div id="plan-and-report" hidden>
    <section class="results-section plan-section" aria-labelledby="plan-title">
      <div class="results-section-heading">
        <p class="eyebrow">One small project, built in steps</p>
        <h2 id="plan-title">Your 7-day portfolio plan</h2>
        <p>Each day builds on the last. The goal is a focused project that demonstrates selected skills, not mastery of every tool.</p>
      </div>
      {% if not form_values.current_skills and not form_values.projects_and_work %}
        <p class="general-plan-note"><strong>Beginner-friendly starting plan:</strong> You did not provide skills or project examples, so this plan is based on the job requirements and uses reasonable beginner assumptions.</p>
      {% endif %}
      <ol class="plan-days">
        {% for day in analysis.plan_days %}
          <li class="plan-day">
            <span class="plan-day-number">Day {{ day.day_number }}</span>
            <div class="plan-day-content">
              <h3>{{ day.task }}</h3>
              <dl>
                <div><dt>Deliverable</dt><dd>{{ day.deliverable }}</dd></div>
                <div><dt>Evidence gap addressed</dt><dd>{{ day.targeted_gap }}</dd></div>
                <div><dt>How it helps</dt><dd>{{ day.why_it_matters }}</dd></div>
                <div><dt>Complete when</dt><dd>{{ day.completion_criterion }}</dd></div>
              </dl>
            </div>
          </li>
        {% endfor %}
      </ol>
    </section>

    <section class="results-section final-report" aria-labelledby="final-report-title">
      <p class="eyebrow">A concise record of your next steps</p>
      <h2 id="final-report-title">Final report</h2>
      <h3>Examples that support requirements</h3>
      {% if supported_strengths %}
        <ul>{% for skill in supported_strengths %}<li><strong>{{ skill.skill_name }} — {{ skill.requirement_type|capitalize }} requirement — {{ skill.display_evidence_label }}:</strong> {{ skill.supporting_example_quote }}</li>{% endfor %}</ul>
      {% else %}
        <p>No submitted example was categorized as Evidence provided. This describes the information provided, not your ability.</p>
      {% endif %}

      <h3>Missing or partial evidence</h3>
      {% if priority_gaps %}
        <ul>{% for skill in priority_gaps %}<li><strong>{{ skill.skill_name }} — Evidence gap:</strong> {{ skill.what_is_missing }} <span>({{ skill.display_evidence_label }})</span></li>{% endfor %}</ul>
      {% else %}<p>No evidence gaps were identified in the submitted examples.</p>{% endif %}

      <h3>Prioritized next steps</h3>
      {% if priority_gaps %}
        <ol>{% for skill in priority_gaps %}<li><strong>{{ skill.skill_name }} — Evidence gap:</strong> {{ skill.what_is_missing }}<br><span><strong>Next step:</strong> {{ skill.suggested_next_step }}</span></li>{% endfor %}</ol>
      {% else %}<p>Package the existing examples clearly and use the plan to create a focused project summary.</p>{% endif %}

      <h3>Expected portfolio deliverables</h3>
      <ul>{% for day in analysis.plan_days %}<li>Day {{ day.day_number }}: {{ day.deliverable }}</li>{% endfor %}</ul>

      <h3>Assumptions and limitations</h3>
      <p>{{ analysis.assumptions_and_limitations }}</p>
      {% if uncertain_interpretations %}
        <p class="report-limit">Only inferred requirements with a displayed uncertainty note are marked uncertain. No confidence score is calculated. Evidence categories reflect only submitted information. ProofPath AI does not verify actual ability.</p>
      {% else %}
        <p class="report-limit">No inferred requirements are marked uncertain in this assessment. No confidence score is calculated. Evidence categories reflect only submitted information. ProofPath AI does not verify actual ability.</p>
      {% endif %}
    </section>
  </div>

  <div class="results-actions">
    <a class="button button-secondary" href="{{ url_for('home') }}#internship-form">Analyze another internship</a>
  </div>
{% endblock %}

{% block scripts %}<script src="{{ url_for('static', filename='results.js') }}" defer></script>{% endblock %}
